# ============================================================
#  Variables d'environnement — portfolio ADINGRA
#  Copier ce fichier en .env.local pour le développement local.
#  Sur Vercel : Project Settings > Environment Variables.
#  AUCUNE valeur réelle ne doit être commitée.
# ============================================================

# --- Base de données Neon -----------------------------------
# Neon Console > votre projet > Connection string > "Pooled connection".
# Doit contenir ?sslmode=require
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE/BASE?sslmode=require
DATABASE_URL=

# --- Signature des sessions ---------------------------------
# Secret de signature du jeton de session (JWT).
# Générer une valeur aléatoire d'au moins 32 caractères :
#   openssl rand -base64 48
# Changer cette valeur déconnecte toutes les sessions ouvertes.
AUTH_SECRET=

# --- Compte administrateur initial --------------------------
# Utilisés UNE SEULE FOIS par /api/setup pour créer le compte.
# Le mot de passe n'est jamais stocké en clair : seul son
# empreinte scrypt est enregistrée en base.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Protection de l'endpoint d'installation ----------------
# Jeton exigé dans l'en-tête x-setup-token pour appeler /api/setup.
# Sans lui, l'endpoint refuse toute requête.
#   openssl rand -hex 32
SETUP_TOKEN=
